# ═══════════════════════════════════════════════════════
# ⚠️  HOW TO USE
# ═══════════════════════════════════════════════════════
# 1) Copy this file to create a real `.env`:
#       cp .env.example .env
# 2) Replace every `change_me_*` and placeholder hex with real secrets:
#       python scripts/generate_secret.py     # 32-byte hex for HMAC fingerprints
#       python scripts/generate_fernet.py     # Fernet key
# 3) NEVER add `.env.example` to docker-compose `env_file:` —
#    it will OVERRIDE `.env` because Compose loads files in order.
# 4) Settings declares most fields as REQUIRED. An empty value raises
#    `pydantic_core.ValidationError` at startup.
#
# Sanity check:
#   uv run python -c "from app.core.settings import Settings; print(Settings().model_dump())"
# ═══════════════════════════════════════════════════════

LOG_LEVEL=DEBUG
DEBUG=true
DEBUG_ENABLED=true
DEBUG_PRESET=dev

# ═══════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════
APPLICATION_TITLE="ERP- IoT FastAPI Clean Architecture and DDD Template"
APPLICATION_SUMMARY="This is a Python microservice template using FastAPI, designed to follow Clean Architecture and Domain-Driven Design (DDD) principles."
APPLICATION_DESCRIPTION="### 🚀 ERP- IoT FastAPI Clean Architecture and DDD Template

This template provides a structured approach to building Python microservices with FastAPI, emphasizing Clean Architecture and Domain-Driven Design (DDD) principles.
"
APPLICATION_VERSION="3.0.0"
APPLICATION_CONTACT_NAME="ERP- IoT Team"
APPLICATION_CONTACT_URL="https://example.com"
APPLICATION_CONTACT_EMAIL="you@example.com"
APPLICATION_CONTACT_PHONE="+1 (555) 000-0000"

# Host port mapped to container port 8000 (FastAPI/Uvicorn)
APPLICATION_PORT=8000
APPLICATION_ENVIRONMENT=development
APPLICATION_CONNECT_TIMEOUT_SECONDS=30
APPLICATION_URL=http://localhost:8000

# REQUIRED — prefix on every table name.
# With this value the users table becomes:
#   erp_users
APPLICATION_TABLE_PREFIX=erp


# ═══════════════════════════════════════════════════════
# DJANGO FRONTEND (BFF)
# ═══════════════════════════════════════════════════════
# Host port mapped to container port 8001 (Daphne/ASGI)
DJANGO_PORT=8001

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change_me_generate_with_django_get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# Timeout (seconds) for Django → FastAPI HTTP calls
FASTAPI_TIMEOUT=30


# ═══════════════════════════════════════════════════════
# API KEY
# ═══════════════════════════════════════════════════════
# Visible prefix on generated keys (kept short, URL-safe, e.g. "iap")
API_KEY_PREFIX=iap

# REQUIRED — 32-byte HMAC secret as 64 hex chars.
# Generate with scripts/generate_secret.py
API_KEY_HASH_FINGERPRINT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

API_KEY_ENTROPY_BYTES=32


# ═══════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════
AUTH_BEARER_TOKEN_SCHEME_NAME="BearerAuth"
AUTH_BEARER_TOKEN_SCHEME_DESCRIPTION="Bearer token authentication using JWT."
AUTH_API_KEY_NAME="X-API-Key"
AUTH_API_KEY_SCHEME_NAME="ApiKeyAuth"
AUTH_API_KEY_DESCRIPTION="API key to access the application. This key is used to authenticate requests to the API."


# ═══════════════════════════════════════════════════════
# COOKIES
# ═══════════════════════════════════════════════════════
COOKIES_MAX_AGE_SECONDS=86400
COOKIES_TOKEN_TYPE_KEY="token_type"
COOKIES_ACCESS_TOKEN_KEY="access_token"
COOKIES_ACCESS_TOKEN_PATH="/"
COOKIES_REFRESH_TOKEN_KEY="refresh_token"
COOKIES_REFRESH_TOKEN_PATH="/api/v1/authentication"
COOKIES_DEVICE_KEY="device_id"
COOKIES_DOMAIN=localhost
COOKIES_SAME_SITE=lax


# ═══════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════
JWT_ISSUER="fastapi-clean-architecture-ddd-template"
JWT_AUDIENCE="fastapi-clean-architecture-ddd-template"

# REQUIRED — password protecting the Ed25519 signing private key (PKCS8)
JWT_SIGNING_KEY_PASSWORD=change_me_signing_key_password

# REQUIRED — password protecting the X25519 encryption private key (PKCS8)
JWT_ENCRYPTION_KEY_PASSWORD=change_me_encryption_key_password

JWT_SIGNING_PRIVATE_KEY_PATH="secrets/keys/signing-private.pem"
JWT_SIGNING_PUBLIC_KEY_PATH="secrets/keys/signing-public.pem"
JWT_ENCRYPTION_PRIVATE_KEY_PATH="secrets/keys/encryption-private.pem"
JWT_ENCRYPTION_PUBLIC_KEY_PATH="secrets/keys/encryption-public.pem"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# REQUIRED — 32-byte HMAC secret for hashing JWT `jti` values (64 hex chars).
# Generate with scripts/generate_secret.py
JWT_HASH_FINGERPRINT=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

JWT_AUTO_GENERATE_KEYS=True
JWT_KEYS_DIR="secrets/keys"


# ═══════════════════════════════════════════════════════
# LOGS
# ═══════════════════════════════════════════════════════
LOGS_NAME="fastapi-clean-architecture-ddd-template"
LOGS_PATH="logs"
LOGS_LEVEL="INFO"
LOGS_REQUEST_ID_LENGTH=8
LOGS_PYGMENTS_STYLE="monokai"


# ═══════════════════════════════════════════════════════
# POSTGRESQL
# ═══════════════════════════════════════════════════════
POSTGRESQL_DATABASE=ioterp
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres

# TH: Host port (map ไปยัง container 5432)
#     — local dev ใช้ 5437 เพื่อไม่ชนกับ postgres ที่ติดตั้งในเครื่อง
POSTGRESQL_PORT=5437

# TH: localhost → ใช้ตอนรัน FastAPI บน host
#     ใน docker-compose จะ override เป็น "database" อัตโนมัติ
POSTGRESQL_HOST=localhost


# ═══════════════════════════════════════════════════════
# PGADMIN
# ═══════════════════════════════════════════════════════
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=postgres
PGADMIN_PORT=8099


# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_HOST=127.0.0.1

# TH: Host port (map ไปยัง container 6379)
REDIS_PORT=6378

# REQUIRED — set a real password in production. Non-empty here so Settings
# doesn't raise ValidationError on startup.
REDIS_PASSWORD=change_me_redis_password

REDIS_DB=0
REDIS_DATABASES=16
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_USERNAME=default
REDIS_SSL=False
REDIS_CONNECTION_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_DEFAULT_TTL_SECONDS=3600
REDIS_SESSION_TTL_SECONDS=86400
REDIS_TOMBSTONE_TTL_SECONDS=604800
REDIS_KEY_PREFIX="food-erp:"

# MUST be an integer. Bump this whenever the serialized payload format
# changes — old keys become unreachable and expire by TTL on their own.
REDIS_CACHE_VERSION=1

REDIS_FLUSH_ON_STARTUP=False
REDIS_MAX_CONNECTIONS=50


# ═══════════════════════════════════════════════════════
# REDISINSIGHT
# ═══════════════════════════════════════════════════════
REDISINSIGHT_PORT=8081
REDISINSIGHT_REDIS_ALIAS="food-erp-cache"


# ═══════════════════════════════════════════════════════
# NGROK
# ═══════════════════════════════════════════════════════
NGROK_AUTH_TOKEN=


# ═══════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════
SECURITY_ALLOW_ORIGINS=["http://localhost:8000","http://localhost:8001"]
SECURITY_ALLOW_HEADERS=["*"]
SECURITY_ALLOW_METHODS=["*"]
SECURITY_EMAIL_ALLOWED_DOMAINS=["example.com"]
SECURITY_ADMIN_EMAIL=admin@example.com
SECURITY_ADMIN_PASSWORD=P@ssw0rd
SECURITY_USER_EMAIL=user@example.com
SECURITY_USER_PASSWORD=P@ssw0rd


# ═══════════════════════════════════════════════════════
# MQTT (iot — Real-time Sensor Ingest / Control)
# ═══════════════════════════════════════════════════════
# ─── Docker Compose Host Ports ─────────────────────────
# TH: port บน host ที่ map ไปยัง container
#     MQTT_PORT    → container 1888 (MQTT/TCP)
#     MQTT_WS_PORT → container 9001 (MQTT over WebSocket)
MQTT_PORT=1888
MQTT_WS_PORT=9001

# ─── Client Config ─────────────────────────────────────
# REQUIRED — broker URL (mqtt:// or mqtts:// for TLS).
#   local dev (host FastAPI):  mqtt://localhost:1888
#   docker-compose (override): mqtt://mosquitto:1888
MQTT_BROKER=mqtt://localhost:1888

# REQUIRED — unique client id per backend instance.
# IMPORTANT: must be unique per replica in production, otherwise brokers
# will kick older sessions (MQTT clean_session=True).
MQTT_CLIENT_ID=fastapi-iot-backend

# ─── Credentials ───────────────────────────────────────
# TH: dev mode (mosquitto.conf: allow_anonymous=true)
#     → ต้องปล่อยว่าง ไม่งั้น mosquitto จะ reject (rc=5)
#     production (allow_anonymous=false + password_file):
#     → set MQTT_USERNAME/MQTT_PASSWORD ตาม passwd file
MQTT_USERNAME=ioterp
MQTT_PASSWORD=ioterp

MQTT_KEEPALIVE=30
MQTT_CLEAN_SESSION=true
MQTT_QOS=1

# Wildcard topics — the client subscribes to these on connect.
MQTT_TOPIC_DATA=iot/+/DATA
MQTT_TOPIC_CTRL=iot/+/CTRL

# Optional — reconnect backoff (seconds)
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30


# ═══════════════════════════════════════════════════════
# INFLUXDB (iot — Time-series Storage)
# ═══════════════════════════════════════════════════════
# ─── Docker Compose Host Port ──────────────────────────
# TH: port บน host ที่ map ไปยัง container 8086 (InfluxDB UI + API)
INFLUXDB_PORT=8086

# ─── Initial Setup (ใช้แค่ครั้งแรก ตอน container สร้าง volume) ───
# TH: ค่าเหล่านี้จะถูกใช้ตอน init mode=setup เท่านั้น
#     ครั้งต่อไปที่ restart จะไม่ถูกใช้ (อ่านจาก DB)
#     ⚠️ ต้องมีค่าครบทุกตัว ไม่งั้น InfluxDB จะไม่ init
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=adminpassword
INFLUXDB_RETENTION=365d

# ─── Client Config ─────────────────────────────────────
# REQUIRED — URL of the InfluxDB 2.x instance.
#   local dev (host FastAPI):  http://localhost:8086
#   docker-compose (override): http://influxdb:8086
INFLUXDB_URL=http://localhost:8086

# REQUIRED — API token (InfluxDB → Load Data → API Tokens → Generate).
# Must have read/write access on INFLUXDB_BUCKET.
#
# Generate a strong token:
#   openssl rand -hex 32
# Or use the InfluxDB UI after first boot.
# ⚠️ token นี้ถูกใช้เป็น INIT_ADMIN_TOKEN ตอน init ด้วย
INFLUXDB_TOKEN=erpiot

# REQUIRED — organization name.
# ⚠️ ต้องมีค่า ไม่งั้น InfluxDB init จะ fail (missing parameter)
INFLUXDB_ORG=erpiot

# REQUIRED — bucket where sensor data is stored.
# ⚠️ ต้องมีค่า ไม่งั้น InfluxDB init จะ fail (missing parameter)
INFLUXDB_BUCKET=erpiot

# Timeout (seconds) for InfluxDB queries.
INFLUXDB_TIMEOUT=30


# ═══════════════════════════════════════════════════════
# WEBSOCKET (iot — Real-time Push)  [Part 8]
# ═══════════════════════════════════════════════════════
# Heartbeat interval (seconds) — server pings clients to keep connection alive.
WS_HEARTBEAT_INTERVAL=30

# Max concurrent connections across all rooms.
WS_MAX_CONNECTIONS=1000

# Default room name if client doesn't specify.
WS_ROOM_DEFAULT=default

# Path prefix for iot WebSocket endpoint: /api/v1/iot/ws/{room}
WS_ROOM_PREFIX=/api/v1/iot/ws

# TH: จำนวน messages สูงสุดใน WS broadcast queue (ป้องกัน memory leak)
# EN: max messages in WS broadcast queue (prevent memory leak)
WS_BROADCAST_QUEUE_SIZE=100

# TH: เปิด/ปิด auto-broadcast เมื่อมี alarm trigger
# EN: enable/disable auto-broadcast on alarm trigger
WS_ALARM_BROADCAST_ENABLED=true


# ═══════════════════════════════════════════════════════
# KAFKA (iot — Event Bus, OPTIONAL)
# ═══════════════════════════════════════════════════════
# Disable if you don't want to publish iot domain events to Kafka.
KAFKA_ENABLED=false

# Comma-separated list of brokers.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic for iot domain events (AlarmTriggered, DeviceCreated, ...).
KAFKA_TOPIC_IOT_EVENTS=iot.events

# Consumer group id (if you run a consumer).
KAFKA_CONSUMER_GROUP=fastapi-iot-workers

# Producer reliability.
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3


# ═══════════════════════════════════════════════════════
# IOT ALERT CHANNELS  [Part 10]
# ═══════════════════════════════════════════════════════
# Each channel can be toggled independently. When ENABLED=false, the
# alert service will skip it silently. Multiple channels fire concurrently.
#
# TH: แต่ละ channel เปิด/ปิดได้อิสระ ถ้า ENABLED=false จะข้ามไปโดยไม่ error
#     ถ้าเปิดหลายตัวจะยิงพร้อมกัน (non-blocking)

# ─── Email (SMTP) ──────────────────────────────────────
# TH: ใช้ SMTP ตรง (ไม่ใช่ webhook) — รองรับ Gmail, Outlook, SES
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO="admin@example.com,ops@example.com"
ALERT_EMAIL_FROM="iot-alerts@example.com"
ALERT_SMTP_HOST="smtp.gmail.com"
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=""
ALERT_SMTP_PASS=""
ALERT_SMTP_TLS=true

# ─── LINE Messaging API ────────────────────────────────
# TH: ใช้ LINE Messaging API (ไม่ใช่ LINE Notify ที่ปิดให้บริการแล้ว)
#     สร้าง channel ที่ https://developers.line.biz/console/
#     ขอ Channel Access Token (long-lived)
ALERT_LINE_ENABLED=false
ALERT_LINE_TOKEN=""
# TH: LINE user/group/room IDs (คั่นด้วย comma)
ALERT_LINE_TO=""

# ─── Telegram Bot ──────────────────────────────────────
# TH: สร้าง bot ที่ @BotFather → เอา token
#     หา chat_id จาก @userinfobot
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_IDS=""

# ─── Generic Webhook ───────────────────────────────────
# TH: ยิง POST JSON payload ไป URL ที่กำหนด (สำหรับ Slack, Teams, custom)
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=""

# ─── Alert Behavior ────────────────────────────────────
# TH: ระดับ alarm ที่จะ trigger alert (1=warning, 2=critical)
#     ค่าอื่น (3,4,5) ไม่ trigger
ALERT_TRIGGER_STATUSES=[1,2]

# TH: เปิด alert กับ recovery หรือไม่
ALERT_ON_RECOVERY=false

# TH: cooldown (วินาที) — ป้องกัน spam ต่อ device
ALERT_COOLDOWN_SECONDS=300

# TH: retry ถ้าส่ง fail (max attempts)
ALERT_MAX_RETRIES=3

# TH: timeout (วินาที) ของการส่งแต่ละ channel
ALERT_CHANNEL_TIMEOUT_SECONDS=10


# ═══════════════════════════════════════════════════════
# IOT SCHEDULER  [Part 11]
# ═══════════════════════════════════════════════════════
# TH: APScheduler — background cron jobs
#     ถ้า ENABLED=false จะไม่สร้าง scheduler (ประหยัด resource)

SCHEDULER_ENABLED=true

# TH: timezone ของ scheduler (ต้องมีใน tzdata)
SCHEDULER_TIMEZONE=Asia/Bangkok

# TH: job — cleanup iot_data เก่า (cron format)
#     default: 03:00 ทุกวัน
SCHEDULER_CLEANUP_CRON=0 3 * * *

# TH: จำนวนวันที่จะเก็บ (ถ้าน้อยกว่านี้ลบ)
SCHEDULER_CLEANUP_RETENTION_DAYS=90

# TH: job — ตรวจ device offline (นาที)
SCHEDULER_OFFLINE_CHECK_INTERVAL_MINUTES=5

# TH: ระยะเวลา (นาที) ถือว่า offline ถ้าไม่ส่งข้อมูล
SCHEDULER_OFFLINE_THRESHOLD_MINUTES=15

# TH: job — warmup cache (นาที)
SCHEDULER_WARMUP_INTERVAL_MINUTES=1


# ═══════════════════════════════════════════════════════
# IOT IDEMPOTENCY  [Part 12]
# ═══════════════════════════════════════════════════════
# TH: ป้องกัน duplicate requests ด้วย X-Idempotency-Key header
#     ใช้ Redis เก็บ cached response

IDEMPOTENCY_ENABLED=true

# TH: TTL ของ cached response (วินาที) — default 24 ชั่วโมง
IDEMPOTENCY_TTL_SECONDS=86400

# TH: lock timeout (วินาที) — ป้องกัน concurrent requests
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60

# TH: header name ที่ client ส่งมา
IDEMPOTENCY_HEADER_NAME=X-Idempotency-Key

# TH: paths ที่จะ apply idempotency (regex)
IDEMPOTENCY_PROTECTED_PATHS=["^/iot/control$","^/iot/batch/.*"]


# ═══════════════════════════════════════════════════════
# IOT MULTI-TENANCY  [Part 12]
# ═══════════════════════════════════════════════════════
# TH: tenant isolation
#     - header-based: อ่าน X-Tenant-Id จาก request
#     - query-based: อ่าน ?tenant_id=xxx
#     - RLS: ใช้ PostgreSQL Row-Level Security

TENANT_ENABLED=true

# TH: header ที่จะอ่าน tenant id
TENANT_HEADER_NAME=X-Tenant-Id

# TH: คั่นด้วย comma — fallback order
TENANT_HEADER_FALLBACKS=X-Tenant-Id,tenant_id

# TH: เปิด RLS enforcement (SET LOCAL app.current_tenant)
TENANT_RLS_ENABLED=true

# TH: บังคับให้ต้องมี tenant_id ทุก request หรือไม่
#     false → ถ้าไม่ส่ง ถือว่าเป็น default tenant
TENANT_REQUIRED=false

# TH: tenant id ที่ใช้เมื่อไม่ระบุ (สำหรับ dev/public endpoints)
TENANT_DEFAULT_ID=11111111-1111-1111-1111-111111111111


# ═══════════════════════════════════════════════════════
# IOT RUNTIME BEHAVIOUR
# ═══════════════════════════════════════════════════════
# Default timeout (seconds) when reading MQTT topic synchronously.
IOT_MQTT_READ_TIMEOUT=5

# How many seconds a "last value" cache lives in Redis before falling back
# to the broker.
IOT_CACHE_TTL_SECONDS=10

# Number of records returned by /iot/data/latest when no limit is provided.
IOT_DEFAULT_PAGE_SIZE=20

# Max page size — protects against wide-range scans.
IOT_MAX_PAGE_SIZE=100

# Retention (days) for iot_data — used by /iot/cleanup (default).
IOT_DATA_RETENTION_DAYS=90

# TH: เปิด/ปิด auto-ingest (subscribe "#" → process ทุก message)
#     production แนะนำ true, test แนะนำ false
IOT_AUTO_INGEST_ENABLED=true

# TH: throttle การ save ลง iot_data ต่อ device (วินาที)
IOT_SAVE_THROTTLE_SECONDS=60

# TH: batch size สำหรับ bulk operations
IOT_BATCH_SIZE_MAX=100

# TH: cache TTL ของ latest iot_data (วินาที)
IOT_LATEST_DATA_CACHE_TTL=300

# TH: cache TTL ของ chart (วินาที)
IOT_CHART_CACHE_TTL=41

# TH: cache TTL ของ MQTT payload ต่อ bucket (วินาที)
IOT_MQTT_PAYLOAD_CACHE_TTL=30

# TH: cache TTL ของ device list (วินาที)
IOT_DEVICE_LIST_CACHE_TTL=300


# ═══════════════════════════════════════════════════════
# IOT DATABASE SCHEMA
# ═══════════════════════════════════════════════════════
# REQUIRED — schema name where iot tables live.
# Migration `iot_001_add_iot_tables.py` creates:
#   tenant_iot.devices, tenant_iot.device_configs, ...
IOT_DB_SCHEMA=tenant_iot

# REQUIRED — short prefix used inside the schema (matches generator prefix).
# Table names become: iot_devices, iot_device_configs, ...
IOT_TABLE_PREFIX=iot


# ═══════════════════════════════════════════════════════
# RATE LIMITING (Optional)
# ═══════════════════════════════════════════════════════
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20


# ═══════════════════════════════════════════════════════
# OBSERVABILITY (Optional)
# ═══════════════════════════════════════════════════════
# TH: Prometheus metrics endpoint
METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_PORT=9090

# TH: OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=iot-service

# TH: Sentry error tracking
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

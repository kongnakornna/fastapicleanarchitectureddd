{
  "info": {
    "name": "ERPIoT — Money",
    "_postman_id": "00000000-0000-0000-0000-mon00000000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",  "value": "http://localhost:8000" },
    { "key": "token",     "value": "" },
    { "key": "tenant_id", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "entity_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Money — Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type",    "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/money/",
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"X-001\",\"name\":\"Sample\",\"amount\":\"100.00\"}"
        }
      }
    },
    {
      "name": "Money — List",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/money/?limit=20&offset=0"
      }
    },
    {
      "name": "Money — Get",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/money/{{entity_id}}"
      }
    },
    {
      "name": "Money — Update",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }],
        "url": "{{base_url}}/api/v1/money/{{entity_id}}",
        "body": { "mode": "raw", "raw": "{\"name\":\"Updated\"}" }
      }
    },
    {
      "name": "Money — Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }],
        "url": "{{base_url}}/api/v1/money/{{entity_id}}"
      }
    }
  ]
}
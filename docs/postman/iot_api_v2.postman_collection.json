{
  "info": {
    "name": "iot API v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "bucket", "value": "AIRCOM1" },
    { "key": "deviceId", "value": "1" },
    { "key": "tenant_id", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{base_url}}/iot/status" }
    },
    {
      "name": "Device List",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/iot/device?page=1&pageSize=10",
        "header": [{ "key": "X-Tenant-Id", "value": "{{tenant_id}}" }]
      }
    },
    {
      "name": "Control (Idempotent)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/iot/control",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"topic\":\"AIRCOM1/CONTROL\",\"message\":\"ON\"}"
        }
      }
    },
    {
      "name": "Batch Process",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/iot/batch/process",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"device_id\":\"1\",\"raw_data\":\"25.5\"}]}"
        }
      }
    },
    {
      "name": "Alert Channels",
      "request": { "method": "GET", "url": "{{base_url}}/iot/alerts/channels" }
    },
    {
      "name": "Scheduler Jobs",
      "request": { "method": "GET", "url": "{{base_url}}/iot/admin/scheduler/jobs" }
    },
    {
      "name": "WS Stats",
      "request": { "method": "GET", "url": "{{base_url}}/iot/ws/stats" }
    }
  ]
}
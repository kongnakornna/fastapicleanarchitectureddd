          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "eval",
            "runs",
            "REPLACE",
            "report"
          ]
        }
      }
    },
    {
      "name": "List Metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-Id",
            "value": "{{tenant_id}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/eval/metrics",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "eval",
            "metrics"
          ]

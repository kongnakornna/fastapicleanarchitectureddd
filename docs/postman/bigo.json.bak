{
  "info": {
    "name": "bigo API",
    "_postman_id": "d4e2a216-e899-4f24-8960-d8a98e20ebf1",
    "description": "Big-O Monitoring v1.2.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "topic", "value": "orders.events" },
    { "key": "group_id", "value": "order-processor" }
  ],
  "item": [
    {
      "name": "Big-O Profiles",
      "item": [
        {
          "name": "Analyze Function",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/api/v1/bigo/profiles/analyze", "host": ["{{base_url}}"], "path": ["api","v1","bigo","profiles","analyze"]},
            "body": {"mode": "raw", "raw": "{\"function_name\": \"process_orders\"}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "List Profiles",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/profiles?days=7", "host": ["{{base_url}}"], "path": ["api","v1","bigo","profiles"]}}
        }
      ]
    },
    {
      "name": "Memory",
      "item": [
        {
          "name": "Take Snapshot",
          "request": {"method": "POST", "url": {"raw": "{{base_url}}/api/v1/bigo/memory/snapshots", "host": ["{{base_url}}"], "path": ["api","v1","bigo","memory","snapshots"]}}
        },
        {
          "name": "Detect Leaks",
          "request": {"method": "POST", "url": {"raw": "{{base_url}}/api/v1/bigo/memory/leaks/detect?threshold_mb_per_hour=10", "host": ["{{base_url}}"], "path": ["api","v1","bigo","memory","leaks","detect"]}}
        },
        {
          "name": "List Leaks",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/memory/leaks?status_filter=OPEN", "host": ["{{base_url}}"], "path": ["api","v1","bigo","memory","leaks"]}}
        }
      ]
    },
    {
      "name": "Kafka",
      "item": [
        {
          "name": "Register Topic",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{base_url}}/api/v1/bigo/kafka/topics", "host": ["{{base_url}}"], "path": ["api","v1","bigo","kafka","topics"]}, "body": {"mode": "raw", "raw": "{\"name\": \"orders.events\", \"partitions\": 6, \"replication\": 3}", "options": {"raw": {"language": "json"}}}}
        },
        {
          "name": "Monitor Lag",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{base_url}}/api/v1/bigo/kafka/lag/monitor", "host": ["{{base_url}}"], "path": ["api","v1","bigo","kafka","lag","monitor"]}, "body": {"mode": "raw", "raw": "{\"group_id\": \"{{group_id}}\", \"topic\": \"{{topic}}\", \"threshold\": 10000}", "options": {"raw": {"language": "json"}}}}
        },
        {
          "name": "Activate Backpressure",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{base_url}}/api/v1/bigo/kafka/backpressure/activate", "host": ["{{base_url}}"], "path": ["api","v1","bigo","kafka","backpressure","activate"]}, "body": {"mode": "raw", "raw": "{\"topic\": \"{{topic}}\", \"reason\": \"lag_exceeded\"}", "options": {"raw": {"language": "json"}}}}
        }
      ]
    },
    {
      "name": "Pipeline",
      "item": [
        {
          "name": "Pipeline Check",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{base_url}}/api/v1/bigo/pipeline/check", "host": ["{{base_url}}"], "path": ["api","v1","bigo","pipeline","check"]}, "body": {"mode": "raw", "raw": "{\"n\": 20000, \"algorithm_type\": \"O(n)\"}", "options": {"raw": {"language": "json"}}}}
        },
        {
          "name": "Pipeline Process",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{base_url}}/api/v1/bigo/pipeline/process", "host": ["{{base_url}}"], "path": ["api","v1","bigo","pipeline","process"]}, "body": {"mode": "raw", "raw": "{\"n\": 5000, \"algorithm_type\": \"O(n)\"}", "options": {"raw": {"language": "json"}}}}
        },
        {
          "name": "Pipeline Metrics",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/pipeline/metrics", "host": ["{{base_url}}"], "path": ["api","v1","bigo","pipeline","metrics"]}}
        },
        {
          "name": "Pipeline Memory",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/pipeline/memory", "host": ["{{base_url}}"], "path": ["api","v1","bigo","pipeline","memory"]}}
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {"name": "Health", "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/admin/health", "host": ["{{base_url}}"], "path": ["api","v1","bigo","admin","health"]}}},
        {"name": "Config", "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/admin/config", "host": ["{{base_url}}"], "path": ["api","v1","bigo","admin","config"]}}},
        {"name": "Cache Stats", "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/admin/cache/stats", "host": ["{{base_url}}"], "path": ["api","v1","bigo","admin","cache","stats"]}}},
        {"name": "WS Stats", "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/admin/ws/stats", "host": ["{{base_url}}"], "path": ["api","v1","bigo","admin","ws","stats"]}}},
        {"name": "Pipeline Policies", "request": {"method": "GET", "url": {"raw": "{{base_url}}/api/v1/bigo/admin/pipeline/policies", "host": ["{{base_url}}"], "path": ["api","v1","bigo","admin","pipeline","policies"]}}}
      ]
    }
  ]
}
# ═══════════════════════════════════════════════════════
# ⚠️  HOW TO USE
# ═══════════════════════════════════════════════════════
# 1) Copy this file to create a real `.env`:
#       cp .env.example .env
# 2) Replace every `change_me_*` and placeholder hex with real secrets:
#       python scripts/generate_secret.py     # 32-byte hex for HMAC fingerprints
#       python scripts/generate_fernet.py     # Fernet key
# 3) NEVER add `.env.example` to docker-compose `env_file:` —
#    it will OVERRIDE `.env` because Compose loads files in order.
# 4) Settings declares most fields as REQUIRED. An empty value raises
#    `pydantic_core.ValidationError` at startup.
#
# Sanity check:
#   uv run python -c "from app.core.settings import Settings; print(Settings().model_dump())"
# ═══════════════════════════════════════════════════════

LOG_LEVEL=DEBUG
DEBUG=true


# ═══════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════
APPLICATION_TITLE="ERP- IoT FastAPI Clean Architecture and DDD Template"
APPLICATION_SUMMARY="This is a Python microservice template using FastAPI, designed to follow Clean Architecture and Domain-Driven Design (DDD) principles."
APPLICATION_DESCRIPTION="### 🚀 ERP- IoT FastAPI Clean Architecture and DDD Template

This template provides a structured approach to building Python microservices with FastAPI, emphasizing Clean Architecture and Domain-Driven Design (DDD) principles.
"
APPLICATION_VERSION="1.0.1"
APPLICATION_CONTACT_NAME="kongnakorn jantakun"
APPLICATION_CONTACT_URL="https://gmail.com"
APPLICATION_CONTACT_EMAIL="kongnakornnna@gmail.com"
APPLICATION_CONTACT_PHONE="+66 (95) 508-8091"

# Host port mapped to container port 8000 (FastAPI/Uvicorn)
APPLICATION_PORT=8000
APPLICATION_ENVIRONMENT=development
APPLICATION_CONNECT_TIMEOUT_SECONDS=30
APPLICATION_URL=http://localhost:8000

# REQUIRED — prefix on every table name.
# With this value the users table becomes:
#   erp_users
APPLICATION_TABLE_PREFIX=erp


# ═══════════════════════════════════════════════════════
# DJANGO FRONTEND (BFF)
# ═══════════════════════════════════════════════════════
# Host port mapped to container port 8001 (Daphne/ASGI)
DJANGO_PORT=8001

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change_me_generate_with_django_get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# Timeout (seconds) for Django → FastAPI HTTP calls
FASTAPI_TIMEOUT=30


# ═══════════════════════════════════════════════════════
# API KEY
# ═══════════════════════════════════════════════════════
# Visible prefix on generated keys (kept short, URL-safe, e.g. "iap")
API_KEY_PREFIX=iap

# REQUIRED — 32-byte HMAC secret as 64 hex chars.
# Generate with scripts/generate_secret.py
API_KEY_HASH_FINGERPRINT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

API_KEY_ENTROPY_BYTES=32


# ═══════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════
AUTH_BEARER_TOKEN_SCHEME_NAME="BearerAuth"
AUTH_BEARER_TOKEN_SCHEME_DESCRIPTION="Bearer token authentication using JWT."
AUTH_API_KEY_NAME="X-API-Key"
AUTH_API_KEY_SCHEME_NAME="ApiKeyAuth"
AUTH_API_KEY_DESCRIPTION="API key to access the application. This key is used to authenticate requests to the API."


# ═══════════════════════════════════════════════════════
# COOKIES
# ═══════════════════════════════════════════════════════
COOKIES_MAX_AGE_SECONDS=86400
COOKIES_TOKEN_TYPE_KEY="token_type"
COOKIES_ACCESS_TOKEN_KEY="access_token"
COOKIES_ACCESS_TOKEN_PATH="/"
COOKIES_REFRESH_TOKEN_KEY="refresh_token"
COOKIES_REFRESH_TOKEN_PATH="/api/v1/authentication"
COOKIES_DEVICE_KEY="device_id"
COOKIES_DOMAIN=localhost
COOKIES_SAME_SITE=lax


# ═══════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════
JWT_ISSUER="fastapi-clean-architecture-ddd-template"
JWT_AUDIENCE="fastapi-clean-architecture-ddd-template"

# REQUIRED — password protecting the Ed25519 signing private key (PKCS8)
JWT_SIGNING_KEY_PASSWORD=change_me_signing_key_password

# REQUIRED — password protecting the X25519 encryption private key (PKCS8)
JWT_ENCRYPTION_KEY_PASSWORD=change_me_encryption_key_password

JWT_SIGNING_PRIVATE_KEY_PATH="secrets/keys/signing-private.pem"
JWT_SIGNING_PUBLIC_KEY_PATH="secrets/keys/signing-public.pem"
JWT_ENCRYPTION_PRIVATE_KEY_PATH="secrets/keys/encryption-private.pem"
JWT_ENCRYPTION_PUBLIC_KEY_PATH="secrets/keys/encryption-public.pem"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# REQUIRED — 32-byte HMAC secret for hashing JWT `jti` values (64 hex chars).
# Generate with scripts/generate_secret.py
JWT_HASH_FINGERPRINT=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

JWT_AUTO_GENERATE_KEYS=True
JWT_KEYS_DIR="secrets/keys"


# ═══════════════════════════════════════════════════════
# LOGS
# ═══════════════════════════════════════════════════════
LOGS_NAME="fastapi-clean-architecture-ddd-template"
LOGS_PATH="logs"
LOGS_LEVEL="INFO"
LOGS_REQUEST_ID_LENGTH=8
LOGS_PYGMENTS_STYLE="monokai"


# ═══════════════════════════════════════════════════════
# POSTGRESQL
# ═══════════════════════════════════════════════════════
POSTGRESQL_DATABASE=ioterp
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_PORT=5437
POSTGRESQL_HOST=localhost


# ═══════════════════════════════════════════════════════
# PGADMIN
# ═══════════════════════════════════════════════════════
PGADMIN_EMAIL=admin@example.com,mycompany.com,gmail.com
PGADMIN_PASSWORD=postgres
PGADMIN_PORT=8099


# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_HOST=127.0.0.1
REDIS_PORT=6378

# REQUIRED — set a real password in production. Non-empty here so Settings
# doesn't raise ValidationError on startup.
REDIS_PASSWORD=change_me_redis_password

REDIS_DB=0
REDIS_DATABASES=16
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_USERNAME=default
REDIS_SSL=False
REDIS_CONNECTION_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_DEFAULT_TTL_SECONDS=3600
REDIS_SESSION_TTL_SECONDS=86400
REDIS_TOMBSTONE_TTL_SECONDS=604800
REDIS_KEY_PREFIX="erp-iot:"

# MUST be an integer. Bump this whenever the serialized payload format
# changes — old keys become unreachable and expire by TTL on their own.
REDIS_CACHE_VERSION=1

REDIS_FLUSH_ON_STARTUP=False
REDIS_MAX_CONNECTIONS=50


# ═══════════════════════════════════════════════════════
# REDISINSIGHT
# ═══════════════════════════════════════════════════════
REDISINSIGHT_PORT=8081
REDISINSIGHT_REDIS_ALIAS="erp-iot-cache"


# ═══════════════════════════════════════════════════════
# NGROK
# ═══════════════════════════════════════════════════════
NGROK_AUTH_TOKEN=


# ═══════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════
SECURITY_ALLOW_ORIGINS=["http://localhost:8000","http://localhost:8001"]
SECURITY_ALLOW_HEADERS=["*"]
SECURITY_ALLOW_METHODS=["*"]
SECURITY_EMAIL_ALLOWED_DOMAINS=["example.com,mycompany.com,gmail.com"]
SECURITY_ADMIN_EMAIL=admin@example.com
SECURITY_ADMIN_PASSWORD=P@ssw0rd
SECURITY_USER_EMAIL=admin@example.com
SECURITY_USER_PASSWORD=P@ssw0rd